library(readr)
library(dplyr)
options(knitr.kable.NA = "")
df_raw <- read_csv("https://raw.githubusercontent.com/nathanielcross04/MPP-Capstone/refs/heads/main/Data/Other%20data/Imp%20policies%20ranked.csv")
diff_cols <- c("year", grep("^diff_", names(df_raw), value = TRUE))
df <- df_raw[, diff_cols]
col_1st <- "#009E73"
col_2nd <- "#80CEB9"
col_3rd <- "#C0E7DC"
wrap_span <- function(value_str, bg) {
paste0('<span style="background-color:', bg, '; padding: 2px 6px; border-radius: 3px;">', value_str, '</span>')
}
val_cols <- grep("^diff_", names(df), value = TRUE)
# Convert to character BEFORE the loop
df_colored <- df |>
mutate(year = as.character(year),
across(all_of(val_cols), as.character))
for (i in seq_len(nrow(df))) {
row_vals <- as.numeric(df[i, val_cols])
non_na_idx <- which(!is.na(row_vals))
if (length(non_na_idx) == 0) next
sorted_unique <- sort(unique(row_vals[non_na_idx]), decreasing = TRUE)
for (j in seq_along(val_cols)) {
v <- row_vals[j]
if (is.na(v)) {
df_colored[i, val_cols[j]] <- ""
next
}
rank_pos <- which(sorted_unique == v)[1]
bg <- switch(as.character(rank_pos),
"1" = col_1st,
"2" = col_2nd,
"3" = col_3rd,
NA_character_)
val_str <- sprintf("%.4f", v)
df_colored[i, val_cols[j]] <- if (!is.na(bg)) wrap_span(val_str, bg) else val_str
}
}
df_colored |>
kable(
col.names = c(
"Year",
"Enf: Lim Coop Detainers",
"Int: Official Eng",
"Pub: Medicaid LPR Kids",
"Pub: Medicaid LPR Preg",
"Pub: Medicaid Unauth Preg",
"Pub: Pub Ins LPR Adults"
),
digits = 2,
align = c("c", "c", "c", "c", "c", "c", "c"),
booktabs = FALSE,
escape = FALSE,
format = "html",
na = ""
) |>
kable_styling(full_width = TRUE) |>
row_spec(1:nrow(df_colored), extra_css = "border-top: none; border-bottom: none;")
