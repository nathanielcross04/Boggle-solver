words <- c("CAT", "CATS", "CART", "TEA", "QUIT", "CAB", "CARAT", "TEAR", "QUA", "REACT")
# ---- 2. Build the lookup sets ----
make_sets <- function(words) {
max_len <- max(nchar(words))
# For each length k, take the first k characters of every word at once
prefixes <- unique(unlist(lapply(seq_len(max_len), function(k) {
unique(substr(words, 1, k))
})))
to_env <- function(x) {
list2env(setNames(as.list(rep(TRUE, length(x))), x),
envir = new.env(hash = TRUE))
}
list(words = to_env(words), prefixes = to_env(prefixes))
}
# ---- 3. The DFS ----
dfs <- function(board, r, c, current, visited, sets, found) {
# Stop if off the board
if (r < 1 || r > nrow(board) || c < 1 || c > ncol(board)) return(invisible())
# Stop if this cell is already used in the current path
if (visited[r, c]) return(invisible())
# Extend the string with this tile
current <- paste0(current, board[r, c])
# Prune: nothing starts with this string
if (!exists(current, envir = sets$prefixes, inherits = FALSE)) return(invisible())
# Record if it's a real word of 3+ letters
if (nchar(current) >= 3 &&
exists(current, envir = sets$words, inherits = FALSE)) {
assign(current, TRUE, envir = found)
}
# Mark this cell used, then explore all 8 neighbors
visited[r, c] <- TRUE
for (dr in -1:1) {
for (dc in -1:1) {
if (dr == 0 && dc == 0) next
dfs(board, r + dr, c + dc, current, visited, sets, found)
}
}
}
# ---- 4. The wrapper ----
solve_boggle <- function(board, sets) {
found   <- new.env(hash = TRUE)
visited <- matrix(FALSE, nrow = nrow(board), ncol = ncol(board))
for (r in seq_len(nrow(board))) {
for (c in seq_len(ncol(board))) {
dfs(board, r, c, "", visited, sets, found)
}
}
sort(ls(found))
}
# ---- 5. Run it ----
sets <- make_sets(words)
solve_boggle(board, sets)
# Expected: "CART" "CAT" "CATS" "QUIT" "TEA"
set.seed(1)
letters_pool <- c(LETTERS[LETTERS != "Q"], "QU")
board <- matrix(sample(letters_pool, 16, replace = TRUE), nrow = 4)
board
