align = c("c", rep("c", ncol(df_colored) - 1)),
caption = "Difference Variables by Year") %>%
kable_styling(
bootstrap_options = c("hover", "condensed", "bordered"),
full_width = FALSE,
font_size = 13
) %>%
column_spec(1, bold = TRUE) %>%
row_spec(0, bold = TRUE, background = "#2C3E50", color = "white") %>%
add_footnote(
c(
paste0('<span style="background:', col_1st, '; padding:2px 8px;">&nbsp;&nbsp;&nbsp;&nbsp;</span> Highest value'),
paste0('<span style="background:', col_2nd, '; padding:2px 8px;">&nbsp;&nbsp;&nbsp;&nbsp;</span> 2nd highest value'),
paste0('<span style="background:', col_3rd, '; padding:2px 8px;">&nbsp;&nbsp;&nbsp;&nbsp;</span> 3rd highest value')
),
notation = "none",
escape = FALSE
)
kt
