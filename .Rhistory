library(readr)
library(dplyr)
options(knitr.kable.NA = "")
df_raw <- read_csv("https://raw.githubusercontent.com/nathanielcross04/MPP-Capstone/refs/heads/main/Data/Other%20data/Imp%20policies%20ranked.csv")
diff_cols <- c("year", grep("^diff_", names(df_raw), value = TRUE))
df <- df_raw[, diff_cols]
col_1st <- "#009E73"
col_2nd <- "#80CEB9"
col_3rd <- "#C0E7DC"
color_cells <- function(x) {
vals <- as.numeric(x)
result <- rep("", length(vals))
non_na_idx <- which(!is.na(vals))
if (length(non_na_idx) == 0) return(result)
sorted_unique <- sort(unique(vals[non_na_idx]), decreasing = TRUE)
for (idx in seq_along(vals)) {
if (is.na(vals[idx])) next
v <- vals[idx]
rank_pos <- which(sorted_unique == v)[1]
bg <- switch(as.character(rank_pos),
"1" = col_1st,
"2" = col_2nd,
"3" = col_3rd,
NA_character_)
if (!is.na(bg)) {
result[idx] <- paste0(
'<span style="background-color:', bg, '; padding: 2px 6px; border-radius: 3px;">',
sprintf("%.4f", v),
'</span>'
)
} else {
result[idx] <- sprintf("%.4f", v)
}
}
result
}
df_colored <- df
df_colored$year <- as.character(df$year)
for (col in grep("^diff_", names(df), value = TRUE)) {
df_colored[[col]] <- color_cells(df[[col]])
}
df_colored |>
kable(
col.names = c(
"Year",
"Enf: Lim Coop Detainers",
"Int: Official Eng",
"Pub: Medicaid LPR Kids",
"Pub: Medicaid LPR Preg",
"Pub: Medicaid Unauth Preg",
"Pub: Pub Ins LPR Adults"
),
digits = 2,
align = c("c", "c", "c", "c", "c", "c", "c"),
booktabs = FALSE,
escape = FALSE,
format = "html",
na = ""
) |>
kable_styling(full_width = TRUE) |>
row_spec(1:nrow(df_colored), extra_css = "border-top: none; border-bottom: none;")
